{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "queue"
    },
    "source_class": {
      "enum": [
        "OBSERVED_FIELD",
        "DEMO_SYNTHETIC"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "interval_start": {
      "type": "string",
      "format": "date-time"
    },
    "interval_end": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Jakarta"
    },
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_class": {
      "enum": [
        "motorcycle",
        "car",
        "pickup_van",
        "minibus",
        "bus",
        "light_truck",
        "medium_truck",
        "heavy_truck",
        "trailer",
        "oversize",
        "all"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "observer_source": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "enum": [
        "VERIFIED",
        "PROVISIONAL",
        "REJECTED"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "provenance_id": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "queue_length_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "queue_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "maximum_extent_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "definition": {
      "type": [
        "string",
        "null"
      ]
    },
    "boundary_censored": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "observation_point": {
      "type": [
        "string",
        "null"
      ]
    },
    "lane_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "length_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "count_unit": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "observation_id",
    "kind",
    "source_class",
    "date",
    "interval_start",
    "interval_end",
    "timezone",
    "location_id",
    "approach",
    "direction",
    "vehicle_class",
    "method",
    "observer_source",
    "quality",
    "confidence",
    "provenance_id",
    "uncertainty",
    "notes",
    "queue_length_m",
    "queue_count",
    "maximum_extent_m",
    "definition",
    "boundary_censored",
    "observation_point",
    "lane_group",
    "length_unit",
    "count_unit"
  ]
}
