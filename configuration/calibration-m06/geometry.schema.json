{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "geometry"
    },
    "source_class": {
      "enum": [
        "OBSERVED_FIELD",
        "DEMO_SYNTHETIC"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "interval_start": {
      "type": "string",
      "format": "date-time"
    },
    "interval_end": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Jakarta"
    },
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_class": {
      "enum": [
        "motorcycle",
        "car",
        "pickup_van",
        "minibus",
        "bus",
        "light_truck",
        "medium_truck",
        "heavy_truck",
        "trailer",
        "oversize",
        "all"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "observer_source": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "enum": [
        "VERIFIED",
        "PROVISIONAL",
        "REJECTED"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "provenance_id": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "crs": {
      "type": [
        "string",
        "null"
      ]
    },
    "survey_point": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      ]
    },
    "road_centerline": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      ]
    },
    "rail_centerline": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      ]
    },
    "lane_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "lane_width_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.01
    },
    "stop_line": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      ]
    },
    "gate_position": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      ]
    },
    "crossing_angle_deg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "verified_track_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "clearance": {
      "type": [
        "object",
        "null"
      ]
    },
    "accuracy_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "observation_id",
    "kind",
    "source_class",
    "date",
    "interval_start",
    "interval_end",
    "timezone",
    "location_id",
    "approach",
    "direction",
    "vehicle_class",
    "method",
    "observer_source",
    "quality",
    "confidence",
    "provenance_id",
    "uncertainty",
    "notes",
    "crs",
    "survey_point",
    "road_centerline",
    "rail_centerline",
    "lane_count",
    "lane_width_m",
    "stop_line",
    "gate_position",
    "crossing_angle_deg",
    "verified_track_count",
    "clearance",
    "accuracy_m"
  ]
}
