{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "railway"
    },
    "source_class": {
      "enum": [
        "OBSERVED_FIELD",
        "DEMO_SYNTHETIC"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "interval_start": {
      "type": "string",
      "format": "date-time"
    },
    "interval_end": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Jakarta"
    },
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_class": {
      "enum": [
        "motorcycle",
        "car",
        "pickup_van",
        "minibus",
        "bus",
        "light_truck",
        "medium_truck",
        "heavy_truck",
        "trailer",
        "oversize",
        "all"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "observer_source": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "enum": [
        "VERIFIED",
        "PROVISIONAL",
        "REJECTED"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "provenance_id": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "warning_start": {
      "type": [
        "string",
        "null"
      ]
    },
    "closure": {
      "type": [
        "string",
        "null"
      ]
    },
    "train_approach": {
      "type": [
        "string",
        "null"
      ]
    },
    "train_pass": {
      "type": [
        "string",
        "null"
      ]
    },
    "train_clearance": {
      "type": [
        "string",
        "null"
      ]
    },
    "barrier_reopen": {
      "type": [
        "string",
        "null"
      ]
    },
    "road_release": {
      "type": [
        "string",
        "null"
      ]
    },
    "train_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "crossing_site_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "train_movement": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "observation_id",
    "kind",
    "source_class",
    "date",
    "interval_start",
    "interval_end",
    "timezone",
    "location_id",
    "approach",
    "direction",
    "vehicle_class",
    "method",
    "observer_source",
    "quality",
    "confidence",
    "provenance_id",
    "uncertainty",
    "notes",
    "warning_start",
    "closure",
    "train_approach",
    "train_pass",
    "train_clearance",
    "barrier_reopen",
    "road_release",
    "train_id",
    "crossing_site_id",
    "train_movement"
  ]
}
